<?xml version="1.0" encoding="utf-8" ?>
<PatternFile>
  <Name>Custom Operations</Name>
  <Description>Entity custom operations objects pattern</Description>
  <Options
		Group="CO"
		AppliesTo="TablesAndViewsAll"
		Overwrite="true"
		FilePath="CO\CO.cs"
		Language="C#"
		/>
  <BaseContent>
    <![CDATA[using System;
using System.Collections.Generic;
using System.Linq;
using [:Namespace:].Base;
using [:Namespace:].Connection;
using [:Namespace:].Models;
using [:Namespace:].Operation;
 
namespace [:Namespace:].CO
{
	[#TablesAndViewsContent#]
}
]]>
  </BaseContent>

  <PatternContent Name="TablesAndViewsContent" ConditionKeyMode="TablesAndViewsAll">
    <BaseContent>[:InnerContent:]</BaseContent>
    <Condition Key="TheReplacement">
      <![CDATA[
	public class [:TableName:]CO : [:TableName:]Operation
	{

		public [:TableName:]CO()
		{
		}
		public [:TableName:]CO(DbBase operationsProvider)
		{
			if (operationsProvider?.ConnectionContainer?.Connection!=null)
			{
				LeaveOpen = operationsProvider.LeaveOpen;
				ConnectionContainer = operationsProvider.ConnectionContainer;
			}
		}
		public [:TableName:]CO(ConnectionContainer connectionContainer, bool leaveOpen)
		{
			if (connectionContainer?.Connection != null)
			{
				LeaveOpen = leaveOpen;
				ConnectionContainer = connectionContainer;
			}
		}
		/// <summary>
        /// if your data tables have a column called dateCreated, this is for you my darling*
		/// other_page
        /// </summary>
        /// <param name="since">it's in the name baby girl</param>
		/// <param name="mode">true - you want last update, false - you want date created, default- false</param>
        /// <returns></returns>
		public List<[:TableName:]> GetSince(DateTime since, bool mode=false)
        {
			return !mode
				? Query<[:TableName:]>(SqlSelectCommand + " WHERE dateCreated>=@DateCreated", new { DateCreated = since }).ToList()
				: Query<[:TableName:]>(SqlSelectCommand + " WHERE lastUpdate>=@LastUpdate", new { LastUpdate = since }).ToList();
        }		
	}
]]>
    </Condition>   
  </PatternContent>
</PatternFile>
