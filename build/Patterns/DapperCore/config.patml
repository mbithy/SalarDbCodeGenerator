<?xml version="1.0" encoding="utf-8" ?>
<PatternFile>
  <Name>Config INI</Name>
  <Description>File that contais app configurations</Description>
  <Options
		Group="ProjectFile"
		AppliesTo="ProjectFile"
		Overwrite="false"
		FilePath="config.ini"
		Language="TXT"
		/>
  <BaseContent>
    <![CDATA[
enviroment=prod
testDbName=dbname
testDbUser=dbuser
testDbPwd=dbpass
testDbIP=dbip
testDbPort=dbport
prodDbName=pdbname
prodDbUser=pdbuser
prodDbPwd=pdbpass
prodDbIP=pdbip
prodDbPort=pdbport
]]>
  </BaseContent>
</PatternFile>